# Copy to .env.local and fill in. See SETUP_TODO.md for how to obtain each value.

ANTHROPIC_API_KEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service account JSON as a single line with \n for newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

GOOGLE_SHEET_ID=
GOOGLE_MEALS_CALENDAR_ID=

# NextAuth Google sign-in (separate OAuth client from the service account above)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_EMAILS=you@example.com

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Shared secret Vercel Cron sends as "Authorization: Bearer $CRON_SECRET".
# For local testing, pass the same value manually when curling /api/generate-menu.
CRON_SECRET=

# Huntersville, NC
LOCATION_LAT=35.4107
LOCATION_LON=-80.8428
